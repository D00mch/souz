%% Client as a Souz peer: thread overview.
flowchart LR
    user["Пользователь<br/>голос или текст"] --> client["Client<br/>backend или mobile_app"]
    client --> clientTools["Поверхности<br/>экран / TTS / медиа / магазин"]

    client -- "message.submit<br/>recognized text + device" --> ingress["Chat / Thread<br/>router"]
    ingress -- "ack + durable events" --> client

    subgraph cloud["Souz Cloud"]
        direction TB
        ingress

        subgraph movie["Thread 1: поиск фильма"]
            direction TB
            movieRequest["Request от пользователя<br/>«Включи какой-нибудь интересный фильм»"]
            movieMemory["Память<br/>вкусовые предпочтения"]
            movieAsk["tool.call<br/>user.ask"]
            movieOpen["tool.call<br/>device.media.open<br/>открыть фильм / Кинопоиск"]
            movieDone["thread.completed<br/>фильм открыт"]

            movieRequest --> movieMemory --> movieAsk --> movieOpen --> movieDone
        end

        subgraph groceries["Thread 2: заказ продуктовой корзины"]
            direction TB
            groceryRequest["Request от пользователя<br/>«Собери корзину по вчерашнему фильму»"]
            history["tool.call<br/>history.search<br/>что смотрели вчера"]
            matchBasket["Сопоставление<br/>фильм → тематическая корзина"]
            confirm["tool.call<br/>user.ask<br/>подтвердить состав"]
            cart["tool.call<br/>magnit.cart.create<br/>корзина Магнит"]
            groceryDone["thread.completed<br/>корзина готова"]

            groceryRequest --> history --> matchBasket --> confirm --> cart --> groceryDone
        end

        ingress --> movieRequest
        ingress --> groceryRequest
    end

    movieAsk -. "target=client<br/>question" .-> client
    movieOpen -. "target=client<br/>open media" .-> client
    confirm -. "target=client<br/>confirm" .-> client
    cart -. "target=client<br/>create cart" .-> client

    client -. "tool.result" .-> movieAsk
    client -. "tool.result" .-> movieOpen
    client -. "tool.result" .-> confirm
    client -. "tool.result" .-> cart

    classDef actor fill:#eef6ff,stroke:#2563eb,stroke-width:1px,color:#0f172a;
    classDef souz fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#0f172a;
    classDef thread fill:#fff7ed,stroke:#f97316,stroke-width:1px,color:#0f172a;
    classDef tool fill:#ecfdf5,stroke:#059669,stroke-width:1px,color:#0f172a;
    classDef terminal fill:#f1f5f9,stroke:#334155,stroke-width:1px,color:#0f172a;

    class user,client,clientTools actor;
    class ingress souz;
    class movieRequest,movieMemory,groceryRequest,matchBasket thread;
    class movieAsk,movieOpen,history,confirm,cart tool;
    class movieDone,groceryDone terminal;
